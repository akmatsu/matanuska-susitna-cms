{
  "name": "cms",
  "version": "1.0.3",
  "private": true,
  "scripts": {
    "build:admin-css": "tailwindcss -i ./src/styles/global.css -o ./public/admin-global.css",
    "watch:admin-css": "tailwindcss -i ./src/styles/global.css -o ./public/admin-global.css --watch",
    "predev": "pnpm run build:admin-css",
    "dev": "concurrently -k -n css,keystone -c cyan,magenta \"pnpm run watch:admin-css\" \"keystone dev --no-db-push\"",
    "start": "NODE_ENV=production keystone start",
    "prebuild": "pnpm run build:admin-css",
    "build": "NODE_ENV=production keystone build",
    "migrate": "prisma migrate deploy",
    "generate": "prisma generate",
    "migrations": "prisma migrate dev",
    "migrations:create": "prisma migrate dev --create-only",
    "reset": "prisma migrate reset",
    "collections:create": "npx ts-node ./scripts/createCollections.ts",
    "collections:remove": "npx ts-node ./scripts/removeCollection.ts",
    "typesense:import:services": "npx ts-node ./scripts/importServices.ts",
    "typesense:import:communities": "npx ts-node ./scripts/importCommunities.ts",
    "migration:resolve": "prisma migrate resolve --rolled-back \"20250612224434_feat_change_address_type_on_assembly_districts\"",
    "migration:status": "prisma migrate status",
    "start:publish-worker": "tsx ./src/redis/publish/worker.ts",
    "start:process-page-views-worker": "tsx ./src/redis/processPageViews/worker.ts",
    "db:seed": "tsx ./seed-data.ts",
    "codegen": "pnpm exec graphql-codegen --config ./codegen.ts",
    "codegen:watch": "pnpm exec graphql-codegen --config ./codegen.ts --watch",
    "postinstall": "prisma generate && keystone postinstall"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1127.0",
    "@graphql-ts/schema": "^1.0.2",
    "@graphql-tools/schema": "^10.0.30",
    "@headlessui/react": "^2.2.9",
    "@keystar/ui": "^0.10.0",
    "@keystone-6/core": "^8.1.0",
    "@keystone-6/fields-document": "^11.0.5",
    "@milkdown/kit": "^7.17.3",
    "@milkdown/react": "^7.17.3",
    "@milkdown/theme-nord": "^7.17.3",
    "@prisma/adapter-pg": "^7.9.0",
    "@prisma/client": "^7.9.0",
    "@prosemirror-adapter/react": "0.4.1",
    "@tiptap/extension-table": "3.22.5",
    "@tiptap/extension-text-align": "^3.22.5",
    "@tiptap/html": "^3.22.5",
    "@tiptap/starter-kit": "^3.22.5",
    "@types/express-session": "^1.18.2",
    "axios": "^1.13.2",
    "bullmq": "^5.65.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.3",
    "express-session": "^1.18.2",
    "fast-xml-parser": "^5.10.1",
    "graphql": "^16.14.2",
    "install": "^0.13.0",
    "ioredis": "^5.8.2",
    "mime-types": "^3.0.2",
    "next": "^16.0.0",
    "next-auth": "^4.24.13",
    "openid-client": "^5.7.1",
    "passport": "^0.7.0",
    "pg": "^8.16.3",
    "pino": "^9.14.0",
    "pluralize": "^8.0.0",
    "react": "^19.0.0",
    "react-aria": "3.50.0",
    "react-datepicker": "^8.10.0",
    "react-dom": "^19.0.0",
    "react-dropzone": "^14.3.8",
    "react-hook-form": "^7.68.0",
    "react-select": "^5.10.2",
    "react-stately": "3.48.0",
    "rehype-stringify": "^10.0.1",
    "remark-directive": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "typesense": "^3.0.6",
    "unified": "^11.0.5",
    "voca": "^1.4.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@faker-js/faker": "^9.9.0",
    "@graphql-codegen/cli": "^5.0.7",
    "@iconify/json": "^2.2.416",
    "@iconify/tailwind4": "^1.2.0",
    "@parcel/watcher": "^2.5.1",
    "@tailwindcss/cli": "^4.1.17",
    "@tailwindcss/postcss": "^4.1.17",
    "@tailwindcss/typography": "^0.5.19",
    "@tsconfig/next": "^2.0.4",
    "@tsconfig/node22": "^22.0.5",
    "@tsconfig/recommended": "^1.0.13",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^4.17.25",
    "@types/mime-types": "^3.0.1",
    "@types/passport": "^1.0.17",
    "@types/pluralize": "^0.0.33",
    "@types/voca": "^1.4.6",
    "concurrently": "^10.0.5",
    "postcss": "^8.5.6",
    "prisma": "^7.9.0",
    "tailwindcss": "^4.1.17",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
